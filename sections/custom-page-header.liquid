{%- assign header_font = section.settings.type_heading_font_family -%}
{%- assign base_font = section.settings.type_body_font_family -%}
{%- assign base_font_bold = base_font | font_modify: 'weight', '600' -%}
{%- assign base_font_italic = base_font | font_modify: 'style', 'italic' -%}
{%- assign base_font_bold_italic = base_font_bold | font_modify: 'style', 'italic' -%}

{%- style -%}
  {{ header_font | font_face: font_display: 'swap' }}
  {{ base_font | font_face: font_display: 'swap' }}
  {{ base_font_bold | font_face: font_display: 'swap' }}
  {{ base_font_italic | font_face: font_display: 'swap' }}
  {{ base_font_bold_italic | font_face: font_display: 'swap' }}
  
  :root {
    --typeHeaderPrimary: {{ section.settings.type_heading_font_family.family }};
    --typeHeaderFallback: {{ section.settings.type_heading_font_family.fallback_families }};
    --typeHeaderSize: {{ section.settings.type_heading_base_size | default: '32' | append: 'px' }};
    --typeHeaderWeight: {{ section.settings.type_heading_font_family.weight }};
    --typeHeaderSpacing: {{ section.settings.type_heading_spacing | default: '25' | divided_by: 1000.00 | append: 'em' }};
    --typeHeaderLineHeight: {{ section.settings.type_heading_line_height | default: 1.4 }};
    
    --typeBasePrimary: {{ section.settings.type_body_font_family.family }};
    --typeBaseFallback: {{ section.settings.type_body_font_family.fallback_families }};
    --typeBaseSize: {{ section.settings.type_body_base_size | default: 16 | append: 'px' }};
    --typeBaseWeight: {{ section.settings.type_body_font_family.weight }};
    --typeBaseSpacing: {{ section.settings.type_body_spacing | default: '50' | divided_by: 1000.00 | append: 'em' }};
    --typeBaseLineHeight: {{ section.settings.type_body_line_height | default: 1.4 }};
    --typeBaselineHeightMinus01: {{ section.settings.type_body_line_height | default: 1.4 | minus: 0.1 }};

    --colorBody: {{ section.settings.color_page_background | default: "#fff" }};
    --colorTextBody: {{ section.settings.color_page_text | default: "#1c1d1d" }};
    --colorBtnPrimary: {{ section.settings.color_button_background | default: "#000" }};
    --colorBtnPrimaryText: {{ section.settings.color_button_text | default: "#fff" }};
    --colorNavText: {{ section.settings.color_page_text | default: "#000" }};
    --colorPrice: {{ section.settings.color_page_text | default: "#1c1d1d" }};
    --colorProductTagBackground: {{ section.settings.color_product_tag_background | default: "#1c1d1d" }};
    --colorProductTagText: {{ section.settings.color_product_tag_text | default: "#ffffff" }};
    --colorSaleTag: {{ section.settings.color_product_tag_backgroud | default: "#1c1d1d" }};
    --colorSaleTagText: {{ section.settings.color_product_tag_text | default: "#ffffff" }};
    --colorCartDot: {{ section.settings.color_cart_dot | default: "#ff4f33" }};
    --colorFooter: {{ section.settings.color_page_background | default: "#fff" }};
    --colorFooterText: {{ section.settings.color_page_text | default: "#1c1d1d" }};

    --colorDrawers: {{ section.settings.color_page_background | default: "#1c1d1d" }};
    --colorDrawersDim: {{ section.settings.color_page_background | default: "#1c1d1d" | color_darken: 5 }};
    --colorDrawerBorder: {{ section.settings.color_page_background | default: "#343535" }};
    --colorDrawerText: {{ section.settings.color_page_text | default: "#fff" }};
    --colorDrawerTextDark: {{ section.settings.color_page_text | default: "#fff" | color_darken: 15 }};
    --colorDrawerButton: {{ section.settings.color_button_background | default: "#a26b25" }};
    --colorDrawerButtonText: {{ section.settings.color_button_text | default: "#fff" }};
  }

  .toolbar,
  .header-sticky-wrapper,
  .announcement-bar,
  .footer__social {
    display: none;
  }

{%- if section.settings.color_page_background_image != blank -%}
  body {
    background-image: url("{{ section.settings.color_page_background_image | image_url: width: 1920 }}");
    background-attachment: scroll;
    background-size: cover;
    background-repeat: no-repeat;
  }
  @media only screen and (min-width: 769px) {
    body {
      background-attachment: fixed;
    }
  }
{%- endif -%}

  .custom-page-header__logo-link {
    width: {{ section.settings.mobile_logo_width }}px;
  }
  @media only screen and (min-width: 769px) {
    .custom-page-header__logo-link {
      width: {{ section.settings.desktop_logo_width }}px;
    }
  }
  
  [data-button_style=square] .btn:not(.btn--secondary):not(.btn--tertiary):not(.btn--inverse):not(.btn--body):not(.btn--static):hover,
  [data-button_style=square] .shopify-payment-button .shopify-payment-button__button--unbranded:not(.btn--secondary):not(.btn--tertiary):not(.btn--inverse):not(.btn--body):not(.btn--static):hover {
    background: var(--colorBtnPrimary);
  }

  .grid-product__tag {
    background-color: var(--colorProductTagBackground);
    color: var(--colorProductTagText);
  }

  .grid-product__tag.grid-product__tag--sold-out {
    background-color: var(--colorProductTagBackground);
    color: var(--colorProductTagText);
  }

  .site-footer {
    border-top: none !important;
  }
{%- endstyle -%}

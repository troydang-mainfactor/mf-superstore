{% doc %}
  @prompt
    blog post with link attachement
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-post-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
  }

  .ai-blog-post-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-blog-post-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-blog-post-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-blog-post-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-blog-post-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-blog-post-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-blog-post-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
  }

  .ai-blog-post-date-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-blog-post-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-blog-post-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    line-height: 1.3;
  }

  .ai-blog-post-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_font_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
  }

  .ai-blog-post-attachment-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: {{ block.settings.attachment_padding }}px;
    background-color: {{ block.settings.attachment_bg_color }};
    border: 1px solid {{ block.settings.attachment_border_color }};
    border-radius: {{ block.settings.attachment_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-blog-post-attachment-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.attachment_hover_bg_color }};
    border-color: {{ block.settings.attachment_hover_border_color }};
  }

  .ai-blog-post-attachment-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.attachment_icon_bg_color }};
    border-radius: 8px;
  }

  .ai-blog-post-attachment-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: {{ block.settings.attachment_icon_color }};
  }

  .ai-blog-post-attachment-info-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-blog-post-attachment-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.attachment_label_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-blog-post-attachment-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.attachment_title_font_size }}px;
    color: {{ block.settings.attachment_title_color }};
    font-weight: 600;
  }

  .ai-blog-post-read-more-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .ai-blog-post-read-more-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-blog-post-read-more-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-post-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-blog-post-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.85);
    }
  }
{% endstyle %}

<blog-post-{{ ai_gen_id }} class="ai-blog-post-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-post-container-{{ ai_gen_id }}">
    {% if block.settings.show_image %}
      <div class="ai-blog-post-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.article %}
          {% if block.settings.article.image %}
            <img
              src="{{ block.settings.article.image | image_url: width: 1200 }}"
              alt="{{ block.settings.article.image.alt | escape }}"
              class="ai-blog-post-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.article.image.width }}"
              height="{{ block.settings.article.image.height }}"
            >
          {% else %}
            <div class="ai-blog-post-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        {% else %}
          <div class="ai-blog-post-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-blog-post-content-{{ ai_gen_id }}">
      {% if block.settings.show_meta %}
        <div class="ai-blog-post-meta-{{ ai_gen_id }}">
          {% if block.settings.article %}
            <div class="ai-blog-post-date-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>{{ block.settings.article.published_at | date: '%B %d, %Y' }}</span>
            </div>
            {% if block.settings.article.author %}
              <div class="ai-blog-post-author-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>{{ block.settings.article.author }}</span>
              </div>
            {% endif %}
          {% else %}
            <div class="ai-blog-post-date-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>{{ 'now' | date: '%B %d, %Y' }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.article %}
        <h2 class="ai-blog-post-title-{{ ai_gen_id }}">{{ block.settings.article.title }}</h2>
      {% else %}
        <h2 class="ai-blog-post-title-{{ ai_gen_id }}">{{ block.settings.custom_title }}</h2>
      {% endif %}

      {% if block.settings.show_excerpt %}
        <div class="ai-blog-post-excerpt-{{ ai_gen_id }}">
          {% if block.settings.article %}
            {% if block.settings.article.excerpt != blank %}
              {{ block.settings.article.excerpt | strip_html | truncate: 200 }}
            {% else %}
              {{ block.settings.article.content | strip_html | truncate: 200 }}
            {% endif %}
          {% else %}
            {{ block.settings.custom_excerpt }}
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.attachment_url != blank %}
        <a href="{{ block.settings.attachment_url }}" class="ai-blog-post-attachment-{{ ai_gen_id }}" {% if block.settings.attachment_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
          <div class="ai-blog-post-attachment-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
            </svg>
          </div>
          <div class="ai-blog-post-attachment-info-{{ ai_gen_id }}">
            <div class="ai-blog-post-attachment-label-{{ ai_gen_id }}">{{ block.settings.attachment_label }}</div>
            <div class="ai-blog-post-attachment-title-{{ ai_gen_id }}">{{ block.settings.attachment_title }}</div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.show_read_more %}
        {% if block.settings.article %}
          <a href="{{ block.settings.article.url }}" class="ai-blog-post-read-more-{{ ai_gen_id }}">
            {{ block.settings.read_more_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {% elsif block.settings.custom_link != blank %}
          <a href="{{ block.settings.custom_link }}" class="ai-blog-post-read-more-{{ ai_gen_id }}">
            {{ block.settings.read_more_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</blog-post-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogPost{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('blog-post-{{ ai_gen_id }}', BlogPost{{ ai_gen_id }});
  })();
</script>


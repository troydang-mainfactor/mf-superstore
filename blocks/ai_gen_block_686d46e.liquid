{% doc %}
  @prompt
    video hero with adjustable size for mobile and desktop. allows embedded autoplay on both mobile and desktop. allows to fit or fill width wise., need to be able to paste a youtube link instead of uploading a video. add an option for it to loop, don't have a button overlay show up. I just want it to be there without an overlay that pops up
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign youtube_id = block.settings.youtube_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first %}
{% if block.settings.youtube_url contains 'youtube.com/watch' %}{% assign youtube_id = block.settings.youtube_url | split: 'v=' | last | split: '&' | first %}{% elsif block.settings.youtube_url contains 'youtube.com/embed/' %}{% assign youtube_id = block.settings.youtube_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '&' | first %}{% elsif block.settings.youtube_url contains 'youtube.com/shorts/' %}{% assign youtube_id = block.settings.youtube_url | split: 'youtube.com/shorts/' | last | split: '?' | first | split: '&' | first %}{% endif %}
{% style %}
.ai-video-hero-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%}.ai-video-hero-{{ ai_gen_id }}__frame{position:relative;width:100%;height:{{ block.settings.desktop_height }}px;overflow:hidden;background:#111}.ai-video-hero-{{ ai_gen_id }}__embed{position:absolute;inset:0;display:block;width:100%;height:100%;border:0;pointer-events:none;transform:{% if block.settings.desktop_fit == 'cover' %}scale(1.35){% else %}scale(1){% endif %}}.ai-video-hero-{{ ai_gen_id }}__empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;text-align:center;padding:20px;font-size:14px}.ai-video-hero-{{ ai_gen_id }}__empty svg{position:absolute;inset:0;width:100%;height:100%;opacity:.35}.ai-video-hero-{{ ai_gen_id }}__empty span{position:relative;z-index:1;background:rgba(0,0,0,.75);padding:8px 12px}@media screen and (max-width:749px){.ai-video-hero-{{ ai_gen_id }}{width:100%}.ai-video-hero-{{ ai_gen_id }}__frame{height:{{ block.settings.mobile_height }}px}.ai-video-hero-{{ ai_gen_id }}__embed{transform:{% if block.settings.mobile_fit == 'cover' %}scale(1.7){% else %}scale(1){% endif %}}}
{% endstyle %}
<div class="ai-video-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-video-hero-{{ ai_gen_id }}__frame">{% if block.settings.youtube_url != blank and youtube_id != blank %}<iframe class="ai-video-hero-{{ ai_gen_id }}__embed" src="https://www.youtube-nocookie.com/embed/{{ youtube_id | escape }}?autoplay=1&mute=1&playsinline=1&controls=0&disablekb=1&fs=0&iv_load_policy=3&modestbranding=1&rel=0&loop={% if block.settings.loop_video %}1{% else %}0{% endif %}{% if block.settings.loop_video %}&playlist={{ youtube_id | escape }}{% endif %}" title="YouTube video" allow="autoplay; encrypted-media" loading="lazy" tabindex="-1" aria-hidden="true"></iframe>{% else %}<div class="ai-video-hero-{{ ai_gen_id }}__empty">{{ 'hero-apparel-1' | placeholder_svg_tag }}<span>Paste a YouTube link to display your video hero</span></div>{% endif %}</div></div>
{% schema %}
{"name":"Video hero","settings":[{"type":"header","content":"Video"},{"type":"text","id":"youtube_url","label":"YouTube link"},{"type":"checkbox","id":"loop_video","label":"Loop video","default":true},{"type":"header","content":"Desktop size"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_height","label":"Height","min":200,"max":900,"step":50,"unit":"px","default":600},{"type":"select","id":"desktop_fit","label":"Width fit","options":[{"value":"cover","label":"Fill"},{"value":"contain","label":"Fit"}],"default":"cover"},{"type":"header","content":"Mobile size"},{"type":"range","id":"mobile_height","label":"Height","min":150,"max":700,"step":50,"unit":"px","default":400},{"type":"select","id":"mobile_fit","label":"Width fit","options":[{"value":"cover","label":"Fill"},{"value":"contain","label":"Fit"}],"default":"cover"}],"presets":[{"name":"Video hero"}],"tag":null,"class":"video-hero-block"}
{% endschema %}
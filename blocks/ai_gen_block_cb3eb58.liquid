{% doc %}
  @prompt
    Collapsible content
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collapsible-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-collapsible-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-collapsible-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-collapsible-header-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.header_background_color }};
    color: {{ block.settings.header_text_color }};
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.3s ease;
  }

  .ai-collapsible-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_color }};
  }

  .ai-collapsible-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-collapsible-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-collapsible-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.header_text_color }};
  }

  .ai-collapsible-header-{{ ai_gen_id }}[aria-expanded="true"] .ai-collapsible-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-collapsible-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-collapsible-content-inner-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_background_color }};
    color: {{ block.settings.content_text_color }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
  }

  .ai-collapsible-content-inner-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-collapsible-content-inner-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }
{% endstyle %}

<collapsible-content-{{ ai_gen_id }} class="ai-collapsible-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..5) %}
    {% liquid
      assign title_key = 'item_' | append: i | append: '_title'
      assign content_key = 'item_' | append: i | append: '_content'
      assign enabled_key = 'item_' | append: i | append: '_enabled'
      assign open_key = 'item_' | append: i | append: '_open'

      assign item_title = block.settings[title_key]
      assign item_content = block.settings[content_key]
      assign item_enabled = block.settings[enabled_key]
      assign item_open = block.settings[open_key]
    %}

    {% if item_enabled %}
      <div class="ai-collapsible-item-{{ ai_gen_id }}">
        <button
          class="ai-collapsible-header-{{ ai_gen_id }}"
          aria-expanded="{% if item_open %}true{% else %}false{% endif %}"
          data-collapsible-trigger
        >
          <h3 class="ai-collapsible-title-{{ ai_gen_id }}">{{ item_title }}</h3>
          <span class="ai-collapsible-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
        <div class="ai-collapsible-content-{{ ai_gen_id }}" data-collapsible-content>
          <div class="ai-collapsible-content-inner-{{ ai_gen_id }}">
            {{ item_content }}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</collapsible-content-{{ ai_gen_id }}>

<script>
  (function() {
    class CollapsibleContent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.triggers = this.querySelectorAll('[data-collapsible-trigger]');
        this.setupEventListeners();
        this.initializeOpenStates();
      }

      initializeOpenStates() {
        this.triggers.forEach((trigger) => {
          const content = trigger.nextElementSibling;
          if (trigger.getAttribute('aria-expanded') === 'true') {
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });
      }

      setupEventListeners() {
        this.triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
            const content = trigger.nextElementSibling;

            if (isExpanded) {
              this.closeItem(trigger, content);
            } else {
              {% if block.settings.accordion_mode %}
                this.triggers.forEach((otherTrigger) => {
                  if (otherTrigger !== trigger) {
                    const otherContent = otherTrigger.nextElementSibling;
                    this.closeItem(otherTrigger, otherContent);
                  }
                });
              {% endif %}
              this.openItem(trigger, content);
            }
          });
        });
      }

      openItem(trigger, content) {
        trigger.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
      }

      closeItem(trigger, content) {
        trigger.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
      }
    }

    customElements.define('collapsible-content-{{ ai_gen_id }}', CollapsibleContent{{ ai_gen_id }});
  })();
</script>


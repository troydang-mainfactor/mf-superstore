{% doc %}
  @prompt
    custom button that is fully customizable and can have custom text and an external link that opens in a new window, i want to make the button smaller, allow for padding above and below the button itself, allow me to reduce desktop width more
{% enddoc %}
{% doc %}
  @prompt
    Customizable link button with narrower desktop width options, small dimensions, and adjustable spacing above and below the button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.space_above }}px;
    padding-bottom: {{ block.settings.space_below }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-custom-link-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: 44px;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-custom-link-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.hover_color }};
    color: {{ block.settings.hover_text_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-custom-link-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
{% endstyle %}

<div class="ai-custom-link-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.button_link != blank %}
    <a class="ai-custom-link-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}" {% if block.settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ block.settings.button_text | escape }}</a>
  {% else %}
    <span class="ai-custom-link-{{ ai_gen_id }}__button">{{ block.settings.button_text | escape }}</span>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom link button",
  "settings": [
    { "type": "header", "content": "Button content" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "External link" },
    { "type": "checkbox", "id": "open_new_window", "label": "Open in a new window", "default": true },
    { "type": "header", "content": "Appearance" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "vertical_padding", "label": "Button vertical padding", "min": 4, "max": 20, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "horizontal_padding", "label": "Button horizontal padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "space_above", "label": "Space above button", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "space_below", "label": "Space below button", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 0 },
    { "type": "color", "id": "button_color", "label": "Background", "default": "#DE2E2E" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#DE2E2E" },
    { "type": "color", "id": "hover_color", "label": "Hover background", "default": "#B91F1F" },
    { "type": "color", "id": "hover_text_color", "label": "Hover text", "default": "#FFFFFF" },
    { "type": "color", "id": "hover_border_color", "label": "Hover border", "default": "#B91F1F" }
  ],
  "presets": [{ "name": "Custom link button" }],
  "tag": null,
  "class": "custom-link-button-block"
}
{% endschema %}
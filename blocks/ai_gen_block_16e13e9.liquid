{% doc %}
  @prompt
    full width image that spans the entire page. , height options start at 0. this is a thin image, increments of 5. Make it so that the whole image is a button that can lead to a link., make it have an option for the image to fill, cover, or fit. make an option for desktop vs mobile image too., make sliders for mobile height and for desktop height
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-full-width-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .ai-full-width-image-link-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.color_button }};
    outline-offset: 2px;
  }

  .ai-full-width-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .ai-full-width-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.desktop_height }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-full-width-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }
  }

  .ai-full-width-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-full-width-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-full-width-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-full-width-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-full-width-image-mobile-{{ ai_gen_id }} {
      display: block;
    }
    .ai-full-width-image-desktop-{{ ai_gen_id }} {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-full-width-image-mobile-{{ ai_gen_id }} {
      display: none;
    }
    .ai-full-width-image-desktop-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<a
  href="{{ block.settings.link_url }}"
  class="ai-full-width-image-link-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  {% if block.settings.link_url == blank %}aria-disabled="true" tabindex="-1"{% endif %}
>
  <div class="ai-full-width-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.desktop_image or block.settings.mobile_image %}
      {% if block.settings.desktop_image %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          class="ai-full-width-image-{{ ai_gen_id }} ai-full-width-image-desktop-{{ ai_gen_id }}"
        >
      {% endif %}

      {% if block.settings.mobile_image %}
        <img
          src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          class="ai-full-width-image-{{ ai_gen_id }} ai-full-width-image-mobile-{{ ai_gen_id }}"
        >
      {% elsif block.settings.desktop_image %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          class="ai-full-width-image-{{ ai_gen_id }} ai-full-width-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    {% else %}
      <div class="ai-full-width-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-full-width-empty-state-{{ ai_gen_id }}">
          Add a desktop and mobile image
        </div>
      </div>
    {% endif %}
  </div>
</a>

{% schema %}
{
  "name": "Full width image link",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Full width image link"
    }
  ]
}
{% endschema %}

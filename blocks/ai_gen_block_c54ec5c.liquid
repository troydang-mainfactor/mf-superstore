{% doc %}
  @prompt
    a footer section that can display menu logo and an email subscription. make it desktop and mobile friendly, logo should be centered on mobile

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-footer-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .ai-footer-logo-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_max_width }}px;
    height: auto;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_max_width }}px;
    height: 60px;
    background-color: {{ block.settings.text_color }};
    opacity: 0.1;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;position: relative;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
    opacity: 0.5;
  }

  .ai-footer-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    opacity: 0.8;
  }

  .ai-footer-menu-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-menu-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.menu_title_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-menu-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-menu-item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-footer-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_link_size }}px;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-footer-menu-link-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-footer-newsletter-section-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-newsletter-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.newsletter_title_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-newsletter-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.newsletter_description_size }}px;
    opacity: 0.8;
    margin: 0;
  }

  .ai-footer-newsletter-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_text_color }};
    opacity: 0.6;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-footer-newsletter-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    font-size: 14px;
    margin-top: 8px;
  }

  .ai-footer-newsletter-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 14px;
    margin-top: 8px;
  }

  .ai-footer-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: {{ block.settings.text_color }};opacity: 0.5;text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .ai-footer-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: {{ block.settings.mobile_alignment }};
    }

    .ai-footer-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px 20px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-footer-logo-section-{{ ai_gen_id }} {
      align-items: center;
    }

    .ai-footer-logo-{{ ai_gen_id }} {
      max-width: {{ block.settings.mobile_logo_max_width }}px;
    }

    .ai-footer-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_max_width }}px;
      margin: 0 auto;
    }

    .ai-footer-newsletter-form-{{ ai_gen_id }} {
      {% if block.settings.mobile_newsletter_layout == 'stacked' %}
        flex-direction: column;
      {% else %}
        flex-direction: row;
      {% endif %}
    }

    {% if block.settings.mobile_newsletter_layout == 'inline' %}
      .ai-footer-newsletter-input-{{ ai_gen_id }} {
        flex: 1;
      }
    {% endif %}
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-content-{{ ai_gen_id }}"><div class="ai-footer-logo-section-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img
            src="{{ block.settings.logo | image_url: width: 400}}"
            alt="{{ shop.name }}"
            class="ai-footer-logo-{{ ai_gen_id }}"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"loading="lazy"
          >
        {% else %}
          <div class="ai-footer-logo-placeholder-{{ ai_gen_id }}">
            {{'image' | placeholder_svg_tag }}<div class="ai-footer-empty-state-{{ ai_gen_id }}">
              Add your logo
            </div>
          </div>
        {% endif %}
        
        {% if block.settings.description != blank %}
          <div class="ai-footer-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="ai-footer-menu-section-{{ ai_gen_id }}">
        {% if block.settings.menu_title != blank %}
          <h3 class="ai-footer-menu-title-{{ ai_gen_id }}">{{ block.settings.menu_title }}</h3>
        {% endif %}
        
        {% if block.settings.menu != blank %}
          <ul class="ai-footer-menu-{{ ai_gen_id }}">
            {% for link in block.settings.menu.links %}
              {%- comment %}<locksmith:d12f>{% endcomment -%}
                {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: link, subject_parent: block.settings.menu, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
              {%- comment %}</locksmith:d12f>{% endcomment -%}
              <li class="ai-footer-menu-item-{{ ai_gen_id }}">
                <a href="{{ link.url }}" class="ai-footer-menu-link-{{ ai_gen_id }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="ai-footer-empty-state-{{ ai_gen_id }}">
            Select a menu to display
          </div>
        {% endif %}
      </div>

      <div class="ai-footer-newsletter-section-{{ ai_gen_id }}">
        {% if block.settings.newsletter_title != blank %}
          <h3 class="ai-footer-newsletter-title-{{ ai_gen_id }}">{{ block.settings.newsletter_title }}</h3>
        {% endif %}
        
        {% if block.settings.newsletter_description != blank %}
          <p class="ai-footer-newsletter-description-{{ ai_gen_id }}">
            {{ block.settings.newsletter_description }}
          </p>
        {% endif %}

        {% form 'customer' %}
          <div class="ai-footer-newsletter-form-{{ ai_gen_id }}"><input
              type="email"
              name="contact[email]"
              class="ai-footer-newsletter-input-{{ ai_gen_id }}"
              value="{{ form.email }}"
              placeholder="{{ block.settings.email_placeholder }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-footer-newsletter-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-footer-newsletter-success-{{ ai_gen_id }}"
              {% endif %}required
            >
            <button
              type="submit"
              class="ai-footer-newsletter-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </button>
          </div>
          
          {% if form.errors %}
            <div
              id="ai-footer-newsletter-error-{{ ai_gen_id }}"
              class="ai-footer-newsletter-error-{{ ai_gen_id }}"
            >
              {{ form.errors.messages.email }}
            </div>
          {% endif %}
          
          {% if form.posted_successfully? %}
            <div
              id="ai-footer-newsletter-success-{{ ai_gen_id }}"
              class="ai-footer-newsletter-success-{{ ai_gen_id }}"
            >
              {{ block.settings.success_message }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{

{% doc %}
  @prompt
    full width image that spans the entire page. , height options start at 0. this is a thin image, increments of 5. Make it so that the whole image is a button that can lead to a link., make it have an option for the image to fill, cover, or fit. make an option for desktop vs mobile image too., make sliders for mobile height and for desktop height
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-full-width-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
  }

  .ai-full-width-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
    overflow: hidden;
    text-decoration: none;
    cursor: {% if block.settings.image_link %}pointer{% else %}default{% endif %};
  }

  .ai-full-width-image-link-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
  }

  .ai-full-width-image-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-full-width-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-full-width-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-full-width-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-full-width-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-full-width-image-link-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-full-width-image-desktop-{{ ai_gen_id }} {
      display: {% if block.settings.mobile_image %}none{% else %}block{% endif %};
    }

    .ai-full-width-image-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<div class="ai-full-width-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image_link %}
    <a href="{{ block.settings.image_link }}" class="ai-full-width-image-link-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2400 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-full-width-image-desktop-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-full-width-image-placeholder-{{ ai_gen_id }} ai-full-width-image-desktop-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-full-width-image-empty-state-{{ ai_gen_id }}">
            Add a desktop image to get started
          </div>
        </div>
      {% endif %}

      {% if block.settings.mobile_image %}
        <img
          src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          class="ai-full-width-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    </a>
  {% else %}
    <div class="ai-full-width-image-link-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2400 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-full-width-image-desktop-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-full-width-image-placeholder-{{ ai_gen_id }} ai-full-width-image-desktop-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-full-width-image-empty-state-{{ ai_gen_id }}">
            Add a desktop image and link to get started
          </div>
        </div>
      {% endif %}

      {% if block.settings.mobile_image %}
        <img
          src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          class="ai-full-width-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Full width image",
  "settings": [
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to use desktop image on mobile"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Fit"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    }
  ],
  "presets": [
    {
      "name": "Full width image"
    }
  ]
}
{% endschema %}
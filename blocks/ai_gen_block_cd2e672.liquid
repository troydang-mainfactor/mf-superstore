{% doc %}
  @prompt
    Can you create a newsletter form with the ability to change the link color? If I have this set up on a bunch of collection pages I want to be able to change the branding for each specific collection page. I also want to have the ability to tag customers when they submit the form so that I know what collection page they subscribed from.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture ai_form_class %}ai-newsletter__customer-form-{{ ai_gen_id }}{% endcapture %}
{% capture ai_customer_tags %}{{ block.settings.customer_tag }}{% if collection.handle != blank %}, collection-{{ collection.handle }}{% endif %}{% endcapture %}

{% style %}
  .ai-newsletter-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; padding: 32px; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; text-align: {{ block.settings.alignment }}; box-sizing: border-box; }
  .ai-newsletter__inner-{{ ai_gen_id }} { width: 100%; max-width: 680px; margin: 0 auto; }
  .ai-newsletter__heading-{{ ai_gen_id }} { margin: 0 0 10px; color: {{ block.settings.text_color }}; font-family: {{ settings.type_header_font_family.family }}, sans-serif; font-size: 28px; line-height: 1.2; }
  .ai-newsletter__text-{{ ai_gen_id }} { margin: 0 0 22px; color: {{ block.settings.text_color }}; font-size: 16px; line-height: 1.5; }
  .ai-newsletter__text-{{ ai_gen_id }} a { color: {{ block.settings.link_color }}; text-decoration: underline; text-underline-offset: 2px; }
  .ai-newsletter__text-{{ ai_gen_id }} a:hover, .ai-newsletter__text-{{ ai_gen_id }} a:focus-visible { color: {{ block.settings.link_hover_color }}; }
  .ai-newsletter__form-{{ ai_gen_id }} { display: flex; align-items: stretch; gap: 10px; text-align: left; }
  .ai-newsletter__input-{{ ai_gen_id }} { min-width: 0; flex: 1 1 auto; padding: 14px 16px; border: 1px solid {{ block.settings.input_border_color }}; border-radius: 4px; background: {{ block.settings.input_background_color }}; color: {{ block.settings.input_text_color }}; font: inherit; }
  .ai-newsletter__input-{{ ai_gen_id }}:focus-visible, .ai-newsletter__button-{{ ai_gen_id }}:focus-visible { outline: 2px solid {{ block.settings.link_color }}; outline-offset: 2px; }
  .ai-newsletter__button-{{ ai_gen_id }} { flex: 0 0 auto; padding: 14px 24px; border: 0; border-radius: 4px; background: {{ settings.color_button }}; color: {{ settings.color_button_text }}; cursor: pointer; font: inherit; font-weight: 700; }
  .ai-newsletter__button-{{ ai_gen_id }}:hover { background: {{ block.settings.button_hover_color }}; }
  .ai-newsletter__message-{{ ai_gen_id }} { margin: 14px 0 0; font-size: 14px; line-height: 1.4; }
  .ai-newsletter__message--success-{{ ai_gen_id }} { color: {{ block.settings.success_color }}; }
  .ai-newsletter__message--error-{{ ai_gen_id }} { color: {{ block.settings.error_color }}; }
  @media screen and (max-width: 749px) { .ai-newsletter-{{ ai_gen_id }} { padding: 24px 18px; } .ai-newsletter__form-{{ ai_gen_id }} { flex-direction: column; } .ai-newsletter__button-{{ ai_gen_id }} { width: 100%; } }
{% endstyle %}

<div class="ai-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-newsletter__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}<h2 class="ai-newsletter__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.description != blank %}<div class="ai-newsletter__text-{{ ai_gen_id }}">{{ block.settings.description }}</div>{% endif %}
    {% form 'customer', class: ai_form_class %}
      <input type="hidden" name="contact[tags]" value="{{ ai_customer_tags | strip | escape }}">
      <input type="hidden" name="contact[accepts_marketing]" value="true">
      <div class="ai-newsletter__form-{{ ai_gen_id }}">
        <label class="visually-hidden" for="ai-newsletter-email-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
        <input id="ai-newsletter-email-{{ ai_gen_id }}" class="ai-newsletter__input-{{ ai_gen_id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ block.settings.email_placeholder | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" aria-required="true" required>
        <button class="ai-newsletter__button-{{ ai_gen_id }}" type="submit">{{ block.settings.button_label | escape }}</button>
      </div>
      {% if form.posted_successfully? %}<p class="ai-newsletter__message-{{ ai_gen_id }} ai-newsletter__message--success-{{ ai_gen_id }}" role="status">{{ block.settings.success_message | escape }}</p>{% elsif form.errors %}<p class="ai-newsletter__message-{{ ai_gen_id }} ai-newsletter__message--error-{{ ai_gen_id }}" role="alert">{{ form.errors.messages.email | default: block.settings.error_message | escape }}</p>{% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter form",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the know" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Sign up for updates, new releases, and exclusive offers.</p>" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Please enter a valid email address." },
    { "type": "header", "content": "Customer tagging" },
    { "type": "text", "id": "customer_tag", "label": "Custom customer tag", "default": "newsletter" },
    { "type": "paragraph", "content": "Each submission also receives an automatic collection-handle tag when this block is used on a collection page." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f7f7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "link_color", "label": "Link", "default": "#000000" },
    { "type": "color", "id": "link_hover_color", "label": "Link hover", "default": "#de2e2e" },
    { "type": "color", "id": "input_background_color", "label": "Input background", "default": "#ffffff" },
    { "type": "color", "id": "input_text_color", "label": "Input text", "default": "#000000" },
    { "type": "color", "id": "input_border_color", "label": "Input border", "default": "#000000" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#000000" },
    { "type": "color", "id": "success_color", "label": "Success message", "default": "#006b3c" },
    { "type": "color", "id": "error_color", "label": "Error message", "default": "#b00020" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "center" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [ { "name": "Newsletter form" } ],
  "tag": null,
  "class": "newsletter-form-block"
}
{% endschema %}
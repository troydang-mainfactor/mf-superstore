{% doc %}
  @prompt
    "About us section" side by side image and text., Give more options for resizing image portion, Add font customization
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #000000;
    background: {{ block.settings.background_color }};
  }

  .ai-about-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, {{ block.settings.image_width_percent }}fr) minmax(0, {{ 100 | minus: block.settings.image_width_percent }}fr);
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-about-{{ ai_gen_id }}--image-right .ai-about-{{ ai_gen_id }}__media { order: 2; }
  .ai-about-{{ ai_gen_id }}--image-right .ai-about-{{ ai_gen_id }}__content { order: 1; }

  .ai-about-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    width: {{ block.settings.image_size_percent }}%;
    max-width: 100%;
    justify-self: {% if block.settings.image_position == 'right' %}end{% else %}start{% endif %};
    border-radius: {{ block.settings.image_radius }}px;
    background: #f4f4f4;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-about-{{ ai_gen_id }}__media img,
  .ai-about-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    object-position: {{ block.settings.image_focus }};
  }

  .ai-about-{{ ai_gen_id }}__placeholder { position: relative; width: 100%; height: 100%; }
  .ai-about-{{ ai_gen_id }}__placeholder svg { color: #777777; }
  .ai-about-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 10px 12px;
    color: #1c1d1d;
    background: rgba(255, 255, 255, 0.94);
    font-size: 14px;
    text-align: center;
  }

  .ai-about-{{ ai_gen_id }}__content { padding: 20px 0; text-align: {{ block.settings.text_alignment }}; }
  .ai-about-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 10px;
    color: #444444;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.eyebrow_size }}px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ai-about-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: #000000;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_font.weight }};
    line-height: 1.15;
  }
  .ai-about-{{ ai_gen_id }}__copy {
    color: #1c1d1d;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    font-weight: {{ block.settings.body_font.weight }};
    line-height: 1.6;
  }
  .ai-about-{{ ai_gen_id }}__copy p { margin: 0 0 14px; }
  .ai-about-{{ ai_gen_id }}__copy p:last-child { margin-bottom: 0; }

  @media screen and (max-width: 749px) {
    .ai-about-{{ ai_gen_id }} { width: 100%; }
    .ai-about-{{ ai_gen_id }}__inner { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .ai-about-{{ ai_gen_id }}__media { width: {{ block.settings.image_size_mobile }}%; justify-self: center; }
    .ai-about-{{ ai_gen_id }}--image-right .ai-about-{{ ai_gen_id }}__media,
    .ai-about-{{ ai_gen_id }}--image-right .ai-about-{{ ai_gen_id }}__content { order: initial; }
    .ai-about-{{ ai_gen_id }}__content { padding: 0; }
    .ai-about-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
  }
{% endstyle %}

<div class="ai-about-{{ ai_gen_id }}{% if block.settings.image_position == 'right' %} ai-about-{{ ai_gen_id }}--image-right{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-about-{{ ai_gen_id }}__inner">
    <div class="ai-about-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-about-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-about-{{ ai_gen_id }}__empty-state">Add an image to introduce your brand</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-about-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-about-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-about-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-about-{{ ai_gen_id }}__copy">{{ block.settings.body }}</div>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About us section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About us" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Share the story behind your brand, what you believe in, and what makes your work meaningful.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "jost_n5" },
    { "type": "font_picker", "id": "body_font", "label": "Text font", "default": "archivo_narrow_n4" },
    { "type": "range", "id": "eyebrow_size", "label": "Small heading size", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Layout and style" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "image_width_percent", "label": "Image column width", "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_size_percent", "label": "Image size on desktop", "min": 60, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "image_size_mobile", "label": "Image size on mobile", "min": 60, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "image_aspect_ratio", "label": "Image shape", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "3 / 4", "label": "Portrait" }, { "value": "16 / 9", "label": "Wide" }], "default": "4 / 3" },
    { "type": "select", "id": "image_fit", "label": "Image fitting", "options": [{ "value": "cover", "label": "Fill frame" }, { "value": "contain", "label": "Fit entire image" }], "default": "cover" },
    { "type": "select", "id": "image_focus", "label": "Image focus", "options": [{ "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }], "default": "center center" },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 22, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "body_size", "label": "Text size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "About us section" }],
  "tag": null,
  "class": "about-us-block"
}
{% endschema %}
{% doc %}
  @prompt
    dotted border line
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dotted-border-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.margin_top }}px auto {{ block.settings.margin_bottom }}px;
  }

  .ai-dotted-border-line-{{ ai_gen_id }} {
    width: 100%;
    height: 0;
    border: none;
    border-top: {{ block.settings.border_thickness }}px dotted {{ block.settings.border_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-dotted-border-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-dotted-border-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-dotted-border-line-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "Dotted border line",
  "settings": [
    {
      "type": "header",
      "content": "Border style"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Dotted border line"
    }
  ]
}
{% endschema %}

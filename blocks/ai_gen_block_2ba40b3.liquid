{% doc %}
  @prompt
    Can you create a newsletter form with the ability to change the link color? If I have this set up on a bunch of collection pages I want to be able to change the branding for each specific collection page. I also want to have the ability to tag customers when they submit the form so that I know what collection page they subscribed from., Make it so all content is editable. Buttons, text, font. Give me the option to change format, width, and height on desktop and mobile. Give desktop the option to change width and also stay centered on page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign newsletter_collection_tag = collection.handle | default: 'general' | prepend: 'collection-' %}
{% capture newsletter_form_class %}ai-newsletter__form-{{ ai_gen_id }}{% endcapture %}
{% style %}
  {{ block.settings.font_choice | font_face }}
  .ai-newsletter-{{ ai_gen_id }} { display:block; box-sizing:border-box; width:{{ block.settings.desktop_width_percent }}%; max-width:{{ block.settings.desktop_max_width }}px; min-height:{{ block.settings.desktop_height }}px; padding:{{ block.settings.padding }}px; margin-left:{% if block.settings.center_desktop %}auto{% else %}0{% endif %}; margin-right:{% if block.settings.center_desktop %}auto{% else %}0{% endif %}; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; font-family:{{ block.settings.font_choice.family }}, {{ block.settings.font_choice.fallback_families }}; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__heading-{{ ai_gen_id }} { color:{{ block.settings.text_color }}; font-family:inherit; font-size:{{ block.settings.heading_size }}px; margin:0 0 10px; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__copy-{{ ai_gen_id }}, .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__copy-{{ ai_gen_id }} p { color:{{ block.settings.text_color }}; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__copy-{{ ai_gen_id }} a { color:{{ block.settings.link_color }}; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__form-{{ ai_gen_id }} { display:flex; flex-direction:{% if block.settings.format_style == 'inline' %}row{% else %}column{% endif %}; gap:10px; margin-top:16px; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__input-{{ ai_gen_id }} { flex:1 1 auto; min-width:0; min-height:48px; padding:12px 14px; border:1px solid {{ block.settings.input_border_color }}; border-radius:{{ block.settings.corner_radius }}px; background:{{ block.settings.input_background }}; color:{{ block.settings.input_text_color }}; font:inherit; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__input-{{ ai_gen_id }}::placeholder { color:{{ block.settings.input_text_color }}; opacity:.75; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__button-{{ ai_gen_id }} { flex:0 0 auto; min-height:48px; padding:12px 22px; border:1px solid {{ block.settings.button_background }}; border-radius:{{ block.settings.corner_radius }}px; background:{{ block.settings.button_background }}; color:{{ block.settings.button_text_color }}; font:inherit; cursor:pointer; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__button-{{ ai_gen_id }}:hover { opacity:.88; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__button-{{ ai_gen_id }}:focus-visible, .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__input-{{ ai_gen_id }}:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__message-{{ ai_gen_id }} { flex-basis:100%; margin-top:12px; color:{{ block.settings.text_color }}; }
  @media screen and (max-width:749px) { .ai-newsletter-{{ ai_gen_id }} { width:100%; max-width:100%; min-height:{{ block.settings.mobile_height }}px; padding:{{ block.settings.mobile_padding }}px; margin-left:0; margin-right:0; } .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__form-{{ ai_gen_id }} { flex-direction:column; } .ai-newsletter-{{ ai_gen_id }} .ai-newsletter__button-{{ ai_gen_id }} { width:100%; } }
{% endstyle %}
<div class="ai-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-newsletter__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.description != blank %}<div class="ai-newsletter__copy-{{ ai_gen_id }}">{{ block.settings.description }}</div>{% endif %}
  {% form 'customer', class: newsletter_form_class %}
    <input type="hidden" name="contact[tags]" value="newsletter, {{ newsletter_collection_tag | escape }}{% if block.settings.extra_tag != blank %}, {{ block.settings.extra_tag | escape }}{% endif %}">
    <label class="visually-hidden" for="ai-newsletter-email-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
    <input id="ai-newsletter-email-{{ ai_gen_id }}" class="ai-newsletter__input-{{ ai_gen_id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ block.settings.placeholder | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true">
    <button class="ai-newsletter__button-{{ ai_gen_id }}" type="submit">{{ block.settings.button_label | escape }}</button>
    {% if form.errors %}<div class="ai-newsletter__message-{{ ai_gen_id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% if form.posted_successfully? %}<div class="ai-newsletter__message-{{ ai_gen_id }}" role="status">{{ block.settings.success_message | escape }}</div>{% endif %}
  {% endform %}
</div>
{% schema %}
{
  "name": "Collection newsletter",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Sign up for updates and new releases.</p>" },
    { "type": "text", "id": "email_label", "label": "Email accessibility label", "default": "Email address" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "extra_tag", "label": "Additional customer tag", "default": "collection-newsletter" },
    { "type": "header", "content": "Typography and layout" },
    { "type": "font_picker", "id": "font_choice", "label": "Font", "default": "archivo_narrow_n4" },
    { "type": "select", "id": "format_style", "label": "Form format", "options": [{ "value": "stacked", "label": "Stacked" }, { "value": "inline", "label": "Inline" }], "default": "inline" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "desktop_max_width", "label": "Desktop max width", "min": 300, "max": 1200, "step": 50, "unit": "px", "default": 700 },
    { "type": "checkbox", "id": "center_desktop", "label": "Center on desktop", "default": true },
    { "type": "range", "id": "desktop_height", "label": "Desktop minimum height", "min": 100, "max": 600, "step": 25, "unit": "px", "default": 200 },
    { "type": "range", "id": "mobile_height", "label": "Mobile minimum height", "min": 100, "max": 600, "step": 25, "unit": "px", "default": 200 },
    { "type": "range", "id": "padding", "label": "Desktop padding", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 15 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "Colors and style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1c1d1d" },
    { "type": "color", "id": "link_color", "label": "Link", "default": "#0000ee" },
    { "type": "color", "id": "input_background", "label": "Input background", "default": "#ffffff" },
    { "type": "color", "id": "input_text_color", "label": "Input text", "default": "#1c1d1d" },
    { "type": "color", "id": "input_border_color", "label": "Input border", "default": "#1c1d1d" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#de2e2e" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Collection newsletter" }],
  "tag": null,
  "class": "collection-newsletter-block"
}
{% endschema %}
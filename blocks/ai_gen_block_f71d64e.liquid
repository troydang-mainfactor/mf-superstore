{% doc %}
  @prompt
    generate a row of social icons that are able to be styled. add one for soundcloud, apple music, spotify, and youtube, make the apple music logo an apple logo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-social-icons__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-social-icons__link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .ai-social-icons__link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.icon_hover_background_color }};
    transform: translateY(-2px);
  }

  .ai-social-icons__link-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    fill: {{ block.settings.icon_color }};
    transition: fill 0.3s ease;
  }

  .ai-social-icons__link-{{ ai_gen_id }}:hover svg {
    fill: {{ block.settings.icon_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-social-icons__container-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_alignment }};
    }
  }
{% endstyle %}

<social-icons-{{ ai_gen_id }} class="ai-social-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-icons__container-{{ ai_gen_id }}">
    {% if block.settings.soundcloud_url != blank %}
      <a
        href="{{ block.settings.soundcloud_url }}"
        class="ai-social-icons__link-{{ ai_gen_id }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="SoundCloud"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M7 17.939h-1v-8.068c.308-.231.639-.429 1-.566v8.634zm3 0h1v-9.224c-.229.265-.443.548-.621.857l-.379-.184v8.551zm-2 0h1v-8.848c-.508-.079-.623-.05-1-.01v8.858zm-4 0h1v-7.02c-.312.458-.555.971-.692 1.535l-.308-.182v5.667zm-3-5.25c-.606.547-1 1.354-1 2.268 0 .914.394 1.721 1 2.268v-4.536zm18.879-.671c-.204-2.837-2.404-5.079-5.117-5.079-1.022 0-1.964.328-2.762.877v10.123h9.089c1.607 0 2.911-1.393 2.911-3.106 0-2.233-2.168-3.772-4.121-2.815zm-16.879-.027v5.718c.406.323.923.531 1.5.531h.5v-7.253c-.354.09-.69.231-1 .417v.587z"/>
        </svg>
      </a>
    {% endif %}

    {% if block.settings.apple_music_url != blank %}
      <a
        href="{{ block.settings.apple_music_url }}"
        class="ai-social-icons__link-{{ ai_gen_id }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Apple Music"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M22 17.607c-.786 2.28-3.139 6.317-5.563 6.361-1.608.031-2.125-.953-3.963-.953-1.837 0-2.412.923-3.932.983-2.572.099-6.542-5.827-6.542-10.995 0-4.747 3.308-7.1 6.198-7.143 1.55-.028 3.014 1.045 3.959 1.045.949 0 2.727-1.29 4.596-1.101.782.033 2.979.315 4.389 2.377-3.741 2.442-3.158 7.549.858 9.426zm-5.222-17.607c-2.826.114-5.132 3.079-4.81 5.531 2.612.203 5.118-2.725 4.81-5.531z"/>
        </svg>
      </a>
    {% endif %}

    {% if block.settings.spotify_url != blank %}
      <a
        href="{{ block.settings.spotify_url }}"
        class="ai-social-icons__link-{{ ai_gen_id }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Spotify"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm4.872 17.294c-.185.307-.579.403-.886.217-2.426-1.483-5.479-1.818-9.073-.996-.35.08-.695-.117-.775-.467-.08-.35.117-.695.467-.775 3.909-.895 7.298-.51 10.011 1.135.308.184.403.578.218.886zm1.267-2.82c-.233.384-.731.505-1.115.272-2.777-1.707-7.011-2.201-10.29-1.204-.413.125-.849-.092-.974-.505-.125-.413.092-.849.505-.974 3.749-1.138 8.422-.589 11.602 1.296.384.233.505.731.272 1.115zm.109-2.937c-3.328-1.976-8.82-2.158-11.997-1.193-.496.15-1.02-.13-1.17-.626-.149-.495.13-1.02.626-1.169 3.644-1.107 9.732-.893 13.596 1.381.438.26.581.824.321 1.262-.26.438-.824.581-1.262.321z"/>
        </svg>
      </a>
    {% endif %}

    {% if block.settings.youtube_url != blank %}
      <a
        href="{{ block.settings.youtube_url }}"
        class="ai-social-icons__link-{{ ai_gen_id }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="YouTube"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
        </svg>
      </a>
    {% endif %}
  </div>
</social-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.links = this.querySelectorAll('.ai-social-icons__link-{{ ai_gen_id }}');
      }
    }

    customElements.define('social-icons-{{ ai_gen_id }}', SocialIcons{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Social icons",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "soundcloud_url",
      "label": "SoundCloud URL"
    },
    {
      "type": "url",
      "id": "apple_music_url",
      "label": "Apple Music URL"
    },
    {
      "type": "url",
      "id": "spotify_url",
      "label": "Spotify URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon spacing",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_hover_background_color",
      "label": "Hover background color",
      "default": "#de2e2e"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Hover icon color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Social icons"
    }
  ]
}
{% endschema %}

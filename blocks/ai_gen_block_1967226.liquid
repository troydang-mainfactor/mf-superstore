{% doc %}
  @prompt
    2x2 grid where i can add 4 youtube video links, add a header where I can add text. Add a slider to adjust the size
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-youtube-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-youtube-grid__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.header_alignment }};
  }

  .ai-youtube-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    color: {{ block.settings.header_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-youtube-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-youtube-grid__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: {{ block.settings.video_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-youtube-grid__iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-youtube-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-youtube-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-youtube-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-youtube-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.header_size }}px * 0.8);
    }
  }
{% endstyle %}

<youtube-grid-{{ ai_gen_id }}
  class="ai-youtube-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.header_text != blank %}
    <div class="ai-youtube-grid__header-{{ ai_gen_id }}">
      <h2 class="ai-youtube-grid__title-{{ ai_gen_id }}">{{ block.settings.header_text }}</h2>
    </div>
  {% endif %}

  <div class="ai-youtube-grid__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign video_url_key = 'video_url_' | append: i
        assign video_url = block.settings[video_url_key]
        assign video_id = ''
      %}

      <div class="ai-youtube-grid__item-{{ ai_gen_id }}">
        {% if video_url != blank %}
          {% liquid
            if video_url contains 'youtube.com/watch?v='
              assign video_id = video_url | split: 'v=' | last | split: '&' | first
            elsif video_url contains 'youtu.be/'
              assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
            elsif video_url contains 'youtube.com/embed/'
              assign video_id = video_url | split: 'embed/' | last | split: '?' | first
            endif
          %}

          {% if video_id != blank %}
            <iframe
              class="ai-youtube-grid__iframe-{{ ai_gen_id }}"
              src="https://www.youtube.com/embed/{{ video_id }}"
              title="YouTube video {{ i }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {% else %}
            <div class="ai-youtube-grid__placeholder-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>
          {% endif %}
        {% else %}
          <div class="ai-youtube-grid__placeholder-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</youtube-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class YoutubeGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('youtube-grid-{{ ai_gen_id }}', YoutubeGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "YouTube video grid",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Heading text",
      "default": "Featured videos"
    },
    {
      "type": "range",
      "id": "header_size",
      "label": "Heading size",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "header_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Spacing below heading",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "paragraph",
      "content": "Add YouTube video links. Supports youtube.com/watch, youtu.be, and embed URLs."
    },
    {
      "type": "text",
      "id": "video_url_1",
      "label": "Video 1 URL"
    },
    {
      "type": "text",
      "id": "video_url_2",
      "label": "Video 2 URL"
    },
    {
      "type": "text",
      "id": "video_url_3",
      "label": "Video 3 URL"
    },
    {
      "type": "text",
      "id": "video_url_4",
      "label": "Video 4 URL"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between videos",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "video_bg_color",
      "label": "Video background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "YouTube video grid"
    }
  ]
}
{% endschema %}

{%- liquid
  assign og_title = page_title
  assign og_url = canonical_url
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  if artist_title != blank
    assign og_title = artist_title
  endif
  if artist_description != blank
    assign og_description = artist_description
  endif
-%}

{%- comment -%}
  Artist social image: on any page whose URL path or domain contains one of an
  Artist Brand's keywords (comma-separated; dashes and spaces are ignored when
  matching the domain), use that brand's Social image. Product pages keep their
  own product image.
{%- endcomment -%}
{%- liquid
  assign og_image = page_image
  unless request.page_type == 'product'
    assign og_path = request.path | downcase
    assign og_host = request.host | downcase
    assign og_brand_found = false
    for brand in shop.metaobjects.artist_brand.values
      if og_brand_found or brand.social_image == blank or brand.keywords == blank
        continue
      endif
      assign og_keywords = brand.keywords.value | downcase | split: ','
      for og_keyword in og_keywords
        assign og_keyword = og_keyword | strip
        assign og_keyword_flat = og_keyword | remove: '-' | remove: ' '
        if og_keyword == blank
          continue
        endif
        if og_path contains og_keyword or og_host contains og_keyword_flat
          assign og_image = brand.social_image.value.preview_image
          assign og_brand_found = true
          break
        endif
      endfor
    endfor
  endunless
-%}

{%- if request.page_type == 'product' -%}
  {%- assign og_title = product.title | strip_html -%}
  {%- assign og_type = 'product' -%}
{%- elsif request.page_type == 'article' -%}
  {%- assign og_title = article.title | strip_html -%}
  {%- assign og_type = 'article' -%}
  {%- assign og_description = article.excerpt_or_content | strip_html -%}
{%- elsif request.page_type == 'password' -%}
  {%- liquid
    assign og_title = shop.name
    assign og_url = shop.url
    assign og_description = shop.description | default: shop.name
  -%}
{%- endif -%}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ og_url }}">
  {%- comment %}<locksmith:1f77>{% endcomment -%}
    {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:title" content="{{ og_title | escape }}">{% endif -%}
    {%- comment %}original: <meta property="og:title" content="{{ og_title | escape }}">{%- endcomment %}
  {%- comment %}</locksmith:1f77>{% endcomment -%}
  {%- comment %}<locksmith:2239>{% endcomment -%}
    {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:type" content="{{ og_type }}">{% endif -%}
    {%- comment %}original: <meta property="og:type" content="{{ og_type }}">{%- endcomment %}
  {%- comment %}</locksmith:2239>{% endcomment -%}
  {%- comment %}<locksmith:fd61>{% endcomment -%}
    {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:description" content="{{ og_description | strip_html }}">{% endif -%}
    {%- comment %}original: <meta property="og:description" content="{{ og_description | strip_html }}">{%- endcomment %}
  {%- comment %}</locksmith:fd61>{% endcomment -%}
  {%- if template_base == 'product' -%}
    {%- comment %}<locksmith:45b8>{% endcomment -%}
      {%- capture var %}{% render 'locksmith-variables', variable: 'access_granted' %}{% endcapture %}{% if var == 'true' %}<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">{% endif -%}
      {%- comment %}original: <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">{%- endcomment %}
    {%- comment %}</locksmith:45b8>{% endcomment -%}
    {%- comment %}<locksmith:2857>{% endcomment -%}
      {%- capture var %}{% render 'locksmith-variables', variable: 'access_granted' %}{% endcapture %}{% if var == 'true' %}<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">{% endif -%}
      {%- comment %}original: <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">{%- endcomment %}
    {%- comment %}</locksmith:2857>{% endcomment -%}
  {%- endif -%}
  {%- if og_image -%}
    {%- comment %}<locksmith:eab6>{% endcomment -%}
      {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:image" content="http:{{ og_image | img_url: 'master' }}">{% endif -%}
      {%- comment %}original: <meta property="og:image" content="http:{{ og_image | img_url: 'master' }}">{%- endcomment %}
    {%- comment %}</locksmith:eab6>{% endcomment -%}
    {%- comment %}<locksmith:116c>{% endcomment -%}
      {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta property="og:image:secure_url" content="https:{{ og_image | img_url: 'master' }}">{% endif -%}
      {%- comment %}original: <meta property="og:image:secure_url" content="https:{{ og_image | img_url: 'master' }}">{%- endcomment %}
    {%- comment %}</locksmith:116c>{% endcomment -%}
    <meta property="og:image:width" content="{{ og_image.width }}">
    <meta property="og:image:height" content="{{ og_image.height }}">
  {%- endif -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- comment %}<locksmith:994f>{% endcomment -%}
    {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta name="twitter:title" content="{{ og_title }}">{% endif -%}
    {%- comment %}original: <meta name="twitter:title" content="{{ og_title }}">{%- endcomment %}
  {%- comment %}</locksmith:994f>{% endcomment -%}
  {%- comment %}<locksmith:bea3>{% endcomment -%}
    {%- capture var %}{% render 'locksmith-variables', variable: 'transparent', hiding_scope: 'resource' %}{% endcapture %}{% if var == 'true' %}<meta name="twitter:description" content="{{ og_description | strip_html }}">{% endif -%}
    {%- comment %}original: <meta name="twitter:description" content="{{ og_description | strip_html }}">{%- endcomment %}
  {%- comment %}</locksmith:bea3>{% endcomment -%}
{%- comment -%}
  BLOND:ISH only. Compact product data for assets/blondish-store.js.
  Usage: render 'blondish-product-json', product: product, details_url: url
{%- endcomment -%}
{
  "id": {{ product.id | json }},
  "title": {{ product.title | json }},
  "url": {{ product.url | json }},
  "details_url": {{ details_url | default: product.url | json }},
  "description": {{ product.description | strip_html | truncatewords: 40 | json }},
  "options": {{ product.options | json }},
  "images": [
    {%- for image in product.images limit: 10 -%}
      {{ image | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "variants": [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "title": {{ variant.title | json }},
        "options": {{ variant.options | json }},
        "available": {{ variant.available | json }},
        "price": {{ variant.price | json }},
        "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
        "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
